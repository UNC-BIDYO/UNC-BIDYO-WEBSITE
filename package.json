{
  "name": "unc-bidyo-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "format": "oxfmt src api scripts tests",
    "format:check": "oxfmt --check src api scripts tests",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "{src,api,scripts,tests}/**/*.{ts,tsx,js,mjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "{src,api,scripts,tests}/**/*.css": "oxfmt"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^8.3.6",
    "vite-imagetools": "^12.0.1",
    "vitest": "^5.1.0"
  }
}
